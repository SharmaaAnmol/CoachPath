# ==============================================================================
# CoachPath Frontend Environment Configuration Template (.env.example)
# Duplicate this file to .env.local for local development.
# Configure these variables in your Vercel Project Settings for Staging/Production.
# ==============================================================================

# Public Application URL (Staging / Production)
NEXT_PUBLIC_APP_URL=https://coachpath-staging.vercel.app

# Public API URL
# Option A (Recommended for Vercel + Render): Set to '/api/v1' to use Next.js reverse proxy.
# Option B (Direct Cross-Origin): Set to 'https://coachpath-api-staging.onrender.com/api/v1'
NEXT_PUBLIC_API_URL=/api/v1

# Backend Target URL for Next.js Reverse Proxy (Server-side only — never exposed to browser)
# Used by next.config.mjs rewrites to proxy /api/v1/* to your deployed FastAPI backend.
BACKEND_INTERNAL_URL=https://coachpath-api-staging.onrender.com
