# ==============================================================================
# CoachPath Master Environment Configuration Template (.env.example)
# Duplicate this file to .env and configure values for local or deployed environments.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Environment & Runtime
# ------------------------------------------------------------------------------
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=info
SECRET_KEY=replace-with-a-secure-random-32-character-secret-key-in-staging
ALLOWED_HOSTS=localhost,127.0.0.1,coachpath-staging.vercel.app,coachpath-api-staging.onrender.com

# ------------------------------------------------------------------------------
# Frontend Application (Next.js on Vercel)
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_APP_URL=https://coachpath-staging.vercel.app
NEXT_PUBLIC_API_URL=/api/v1
BACKEND_INTERNAL_URL=https://coachpath-api-staging.onrender.com

# ------------------------------------------------------------------------------
# Backend Application (FastAPI on Render)
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=https://coachpath-staging.vercel.app,http://localhost:3000
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# Authentication & Tokens
# ------------------------------------------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# PostgreSQL Database & pgvector (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://coachpath_owner:your_password@ep-xyz.us-east-2.aws.neon.tech/coachpath_staging?sslmode=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ------------------------------------------------------------------------------
# Redis Cache (Optional for Phase 1 Staging)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# AI Provider Configuration (Google Gemini Backend Secrets)
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=2
ONBOARDING_MAX_TURNS=20

# ------------------------------------------------------------------------------
# Durable Object Storage (Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_RESUME_SIZE_BYTES=10485760
RESUME_EXTRACTION_TIMEOUT=45
S3_ENDPOINT_URL=https://<cloudflare_account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
S3_BUCKET_NAME=coachpath-resumes-staging
S3_REGION_NAME=auto

# ------------------------------------------------------------------------------
# Job Ingestion & Market Intelligence Configuration
# ------------------------------------------------------------------------------
JOB_INGESTION_ENABLED=true
JOB_API_PROVIDER=seed
JOB_API_KEY=
JOB_API_BASE_URL=
JOB_INGESTION_BATCH_SIZE=50
JOB_INGESTION_RATE_LIMIT_PER_MINUTE=30
JOB_FRESHNESS_DAYS_ACTIVE=30
JOB_FRESHNESS_DAYS_STALE=60
