# ==============================================================================
# CoachPath Environment Configuration Template (.env.example)
# Duplicate this file to .env and configure values for local or deployed environments.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Environment & Runtime
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-at-least-32-chars
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# Frontend Application (Next.js)
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# Backend Application (FastAPI)
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# Authentication & Tokens
# ------------------------------------------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# PostgreSQL Database & pgvector
# ------------------------------------------------------------------------------
POSTGRES_USER=coachpath_user
POSTGRES_PASSWORD=coachpath_password
POSTGRES_DB=coachpath_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://coachpath_user:coachpath_password@localhost:5432/coachpath_db

# ------------------------------------------------------------------------------
# Redis Cache & Message Broker
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# AI & LLM Services
# ------------------------------------------------------------------------------
# Primary LLM Provider API Keys (Set whichever provider is active)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Default Models
DEFAULT_LLM_MODEL=gpt-4o
FAST_LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ------------------------------------------------------------------------------
# File Storage & Uploads
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ------------------------------------------------------------------------------
# External Job Data & Market APIs (Optional / Configurable)
# ------------------------------------------------------------------------------
JOB_DATA_PROVIDER_API_KEY=
