# CoachPath Environment Variables
# Application Environment
ENVIRONMENT=development
PORT=8000
DEBUG=True

# Database (Supabase PostgreSQL / local PostgreSQL or local SQLite fallback)
DATABASE_URL=postgresql://coachpath:coachpath_password@localhost:5432/coachpath
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# AI / LLM Configuration
LLM_PROVIDER=gemini # 'gemini', 'anthropic', 'groq', or 'mock_demo'
GEMINI_API_KEY=your-google-ai-studio-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
GROQ_API_KEY=your-groq-key
LLM_FALLBACK_TO_DEMO=true

# Job Market APIs
ADZUNA_APP_ID=your-adzuna-id
ADZUNA_APP_KEY=your-adzuna-key
RAPIDAPI_KEY=your-rapidapi-key

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
