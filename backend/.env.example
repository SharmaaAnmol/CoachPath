# CoachPath Backend Environment Configuration Template
# Copy this file to .env and configure your environment variables

PROJECT_NAME=CoachPath API
VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info

# Server Host & Port
API_HOST=0.0.0.0
API_PORT=8000

# Security (JWT & Password Hashing)
# Generate a secure 32+ character key for production (e.g. openssl rand -hex 32)
SECRET_KEY=insecure-default-change-in-production-secret-key-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database (asyncpg connection string)
DATABASE_URL=postgresql+asyncpg://coachpath_user:coachpath_password@localhost:5432/coachpath_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Redis (Caching & Rate Limiting)
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration (Phase 4A)
# Supported: "gemini" | "groq" | "openai" | "anthropic" | "disabled"
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=2
ONBOARDING_MAX_TURNS=20

# Job Ingestion & Market Intelligence Configuration (Phase 8A)
# Supported Providers: "seed" | "manual" | "arbeitnow" | "mock"
JOB_INGESTION_ENABLED=true
JOB_API_PROVIDER=seed
JOB_API_KEY=
JOB_API_BASE_URL=
JOB_INGESTION_BATCH_SIZE=50
JOB_INGESTION_RATE_LIMIT_PER_MINUTE=30
JOB_FRESHNESS_DAYS_ACTIVE=30
JOB_FRESHNESS_DAYS_STALE=60
