# ==============================================================================
# CoachPath Backend Environment Configuration Template (.env.example)
# Duplicate this file to backend/.env for local development.
# Configure these variables in your Render / Cloud Dashboard for Staging/Production.
# ==============================================================================

# Project Metadata
PROJECT_NAME=CoachPath API
VERSION=0.1.0

# Environment Lifecycle: "development" | "staging" | "production"
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=info

# Server Host & Dynamic Port
API_HOST=0.0.0.0
API_PORT=8000
# PORT is automatically injected by PaaS providers (e.g., Render sets PORT=10000)

# Security (JWT & Session Cookies)
# Generate a secure 32+ character key for staging/production (e.g. openssl rand -hex 32)
SECRET_KEY=replace-with-a-secure-random-32-character-secret-key-in-staging
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Session Cookie Policies
# "lax": Recommended when using same-origin / Next.js reverse proxy on Vercel
# "none": Required for direct cross-origin browser requests between Vercel and Render (enforces Secure=True)
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# CORS Allowed Origins (Comma-separated list of allowed frontend origins)
CORS_ORIGINS=https://coachpath-staging.vercel.app,http://localhost:3000

# PostgreSQL Database (Supports Neon, Supabase, Render, AWS RDS)
# Accepts postgresql+asyncpg://, postgresql://, or postgres:// (automatically normalized to asyncpg)
DATABASE_URL=postgresql+asyncpg://coachpath_owner:your_password@ep-xyz.us-east-2.aws.neon.tech/coachpath_staging?sslmode=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Redis (Caching & Rate Limiting — Optional for Phase 1 Staging)
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration (Google Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=2
ONBOARDING_MAX_TURNS=20

# Durable Document & Resume Storage
# "local": Ephemeral filesystem (uploads/) — Suitable for local dev only
# "r2" or "s3": Durable Cloudflare R2 / AWS S3 object storage (survives restarts)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_RESUME_SIZE_BYTES=10485760
RESUME_EXTRACTION_TIMEOUT=45

# S3 / Cloudflare R2 Credentials (Required when STORAGE_PROVIDER is "r2" or "s3")
S3_ENDPOINT_URL=https://<cloudflare_account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
S3_BUCKET_NAME=coachpath-resumes-staging
S3_REGION_NAME=auto

# Job Ingestion & Market Intelligence Configuration
JOB_INGESTION_ENABLED=true
JOB_API_PROVIDER=seed
JOB_API_KEY=
JOB_API_BASE_URL=
JOB_INGESTION_BATCH_SIZE=50
JOB_INGESTION_RATE_LIMIT_PER_MINUTE=30
JOB_FRESHNESS_DAYS_ACTIVE=30
JOB_FRESHNESS_DAYS_STALE=60
